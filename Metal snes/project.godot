; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Catástrofe en la Biblioteca"
run/main_scene="res://src/levels/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
Game="*res://src/autoload/game.gd"
Pools="*res://src/autoload/pools.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
Debug="*res://src/autoload/debug.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=224
window/size/window_width_override=1280
window/size/window_height_override=896
window/stretch/mode="viewport"

